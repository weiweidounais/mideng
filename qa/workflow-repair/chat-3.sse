data: [{"docId": "6f21f130-8693-4ebe-a34b-074449d5debe", "chunkId": "c70b8c5f-5efb-4f41-91d8-c91b8526d9f3", "title": "P3_举报与申诉流程.docx", "location": "二、申诉 · 段落 10", "content": "需要提交：账号 ID、处罚时间、申诉理由；如果有对局录像或截图，可以一起提交。", "kind": "text", "version": 1, "originalUrl": "/api/documents/6f21f130-8693-4ebe-a34b-074449d5debe/original?version=1"}, {"docId": "6f21f130-8693-4ebe-a34b-074449d5debe", "chunkId": "3d9b063e-7826-45cd-a316-cd28cf9d8e42", "title": "P3_举报与申诉流程.docx", "location": "二、申诉 · 段落 12", "content": "同一次处罚只能申诉 1 次。", "kind": "text", "version": 1, "originalUrl": "/api/documents/6f21f130-8693-4ebe-a34b-074449d5debe/original?version=1"}, {"docId": "6f21f130-8693-4ebe-a34b-074449d5debe", "chunkId": "042d9daa-64bb-4e9f-a135-a9ae3d4ee4dd", "title": "P3_举报与申诉流程.docx", "location": "二、申诉 · 段落 11", "content": "申诉提交后 3 个工作日内回复结果。", "kind": "text", "version": 1, "originalUrl": "/api/documents/6f21f130-8693-4ebe-a34b-074449d5debe/original?version=1"}, {"docId": "6f21f130-8693-4ebe-a34b-074449d5debe", "chunkId": "8197d34a-1f85-4156-a3f8-28d3bc172c1a", "title": "P3_举报与申诉流程.docx", "location": "二、申诉 · 段落 9", "content": "入口：「客服中心 → 封号申诉」。", "kind": "text", "version": 1, "originalUrl": "/api/documents/6f21f130-8693-4ebe-a34b-074449d5debe/original?version=1"}, {"docId": "4d58fb50-633e-4733-850f-cd90165bb1d9", "chunkId": "e4c94d2b-790b-4b44-b7e5-4099bab2e707", "title": "P2_违规处罚标准_公开版_结构化.md", "location": "违规处罚标准（公开版） / 处罚申诉 · 第 35 行", "content": "## 处罚申诉\n\n对处罚结果有异议，可以按《举报与申诉流程》申诉。", "kind": "text", "version": 1, "originalUrl": "/api/documents/4d58fb50-633e-4733-850f-cd90165bb1d9/original?version=1"}]

event: token
data: {"text": "根据《举报与申诉流程》，"}

event: token
data: {"text": "封号申诉的相关信息如下：\n\n-"}

event: token
data: {"text": " **提交资料**：需要提交账号"}

event: token
data: {"text": " ID、处罚时间、申诉理由；"}

event: token
data: {"text": "如果有对局录像或截图，可以"}

event: token
data: {"text": "一起提交。[1]\n- **回复"}

event: token
data: {"text": "时间**：申诉提交后 "}

event: token
data: {"text": "3 个工作日内回复结果。[3"}

event: token
data: {"text": "]\n- **申诉次数**：同"}

event: token
data: {"text": "一次处罚只能申诉 1 次"}

event: token
data: {"text": "。[2]"}

event: done
data: {"session": {"id": "99cf4d2753f44806bebb39178c0aa97d", "title": "封号申诉需要提交什么资料，多久回复，同一次处罚能申诉几次？", "kbIds": ["a6f036b0-14b9-45ff-97c7-f93978c04869"], "messages": [{"id": "8e584b8e145640cfb4c060d750f19072", "role": "user", "content": "封号申诉需要提交什么资料，多久回复，同一次处罚能申诉几次？"}, {"id": "0aa885bb7dd24bf6a15f23ab8de5861d", "role": "assistant", "content": "根据《举报与申诉流程》，封号申诉的相关信息如下：\n\n- **提交资料**：需要提交账号 ID、处罚时间、申诉理由；如果有对局录像或截图，可以一起提交。[1]\n- **回复时间**：申诉提交后 3 个工作日内回复结果。[3]\n- **申诉次数**：同一次处罚只能申诉 1 次。[2]", "status": "complete", "sources": [{"docId": "6f21f130-8693-4ebe-a34b-074449d5debe", "chunkId": "c70b8c5f-5efb-4f41-91d8-c91b8526d9f3", "title": "P3_举报与申诉流程.docx", "location": "二、申诉 · 段落 10", "content": "需要提交：账号 ID、处罚时间、申诉理由；如果有对局录像或截图，可以一起提交。", "kind": "text", "version": 1, "originalUrl": "/api/documents/6f21f130-8693-4ebe-a34b-074449d5debe/original?version=1"}, {"docId": "6f21f130-8693-4ebe-a34b-074449d5debe", "chunkId": "3d9b063e-7826-45cd-a316-cd28cf9d8e42", "title": "P3_举报与申诉流程.docx", "location": "二、申诉 · 段落 12", "content": "同一次处罚只能申诉 1 次。", "kind": "text", "version": 1, "originalUrl": "/api/documents/6f21f130-8693-4ebe-a34b-074449d5debe/original?version=1"}, {"docId": "6f21f130-8693-4ebe-a34b-074449d5debe", "chunkId": "042d9daa-64bb-4e9f-a135-a9ae3d4ee4dd", "title": "P3_举报与申诉流程.docx", "location": "二、申诉 · 段落 11", "content": "申诉提交后 3 个工作日内回复结果。", "kind": "text", "version": 1, "originalUrl": "/api/documents/6f21f130-8693-4ebe-a34b-074449d5debe/original?version=1"}, {"docId": "6f21f130-8693-4ebe-a34b-074449d5debe", "chunkId": "8197d34a-1f85-4156-a3f8-28d3bc172c1a", "title": "P3_举报与申诉流程.docx", "location": "二、申诉 · 段落 9", "content": "入口：「客服中心 → 封号申诉」。", "kind": "text", "version": 1, "originalUrl": "/api/documents/6f21f130-8693-4ebe-a34b-074449d5debe/original?version=1"}, {"docId": "4d58fb50-633e-4733-850f-cd90165bb1d9", "chunkId": "e4c94d2b-790b-4b44-b7e5-4099bab2e707", "title": "P2_违规处罚标准_公开版_结构化.md", "location": "违规处罚标准（公开版） / 处罚申诉 · 第 35 行", "content": "## 处罚申诉\n\n对处罚结果有异议，可以按《举报与申