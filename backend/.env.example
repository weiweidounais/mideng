# Local development: SQLite + Qdrant local persistence + one API process.
DATA_DIR=.runtime
DATABASE_URL=
QDRANT_URL=
TASK_MODE=local
# Set both on first start, at least 10 characters. Otherwise generated into .runtime/bootstrap-passwords.json.
ADMIN_PASSWORD=
MANAGER_PASSWORD=
# Retain this key and/or .runtime/encryption.key with encrypted credential backups.
SECRET_KEY=
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
ALLOW_PRIVATE_PROVIDERS=false
REQUEST_TIMEOUT=60
# Disable hosted LangSmith tracing unless explicitly configured by the operator.
LANGSMITH_TRACING=false
