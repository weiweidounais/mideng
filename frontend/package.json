{
  "name": "zhixu-knowledge-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --mode live --port 15174",
    "build": "tsc -p tsconfig.pilot.json && vite build --mode live",
    "preview": "vite preview --host 127.0.0.1",
    "dev:live": "vite --host 127.0.0.1 --mode live --port 15174",
    "build:prototype": "tsc -b && vite build --mode prototype --outDir dist-prototype",
    "preview:prototype": "vite preview --mode prototype --outDir dist-prototype --host 127.0.0.1 --port 5173 --strictPort",
    "test:prototype": "node scripts/test-prototype.mjs",
    "typecheck": "tsc -p tsconfig.pilot.json",
    "lint": "eslint src/pilot src/pilot-main.tsx",
    "build:legacy": "tsc -p tsconfig.legacy.json && vite build --config vite.legacy.config.ts",
    "test": "node --test scripts/test-pilot.mjs scripts/test-navigation.mjs scripts/test-forms.mjs scripts/test-trace.mjs && node scripts/test-prototype.mjs",
    "build:demo": "tsc -p tsconfig.demo.json && vite build --config vite.demo.config.ts --mode public-demo && node scripts/prepare-demo.mjs",
    "preview:demo": "vite preview --config vite.demo.config.ts --host 127.0.0.1 --port 18432 --strictPort",
    "test:demo": "node --test scripts/test-demo.mjs"
  },
  "dependencies": {
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@xyflow/react": "^12.12.0",
    "antd": "^5.29.0",
    "d3-drag": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "^7.1.12"
  }
}
