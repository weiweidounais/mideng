{
  "name": "zhixu-knowledge-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --mode live",
    "dev:prototype": "vite --host 127.0.0.1 --mode prototype",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dev:live": "vite --host 127.0.0.1 --mode live --port 5174",
    "build:prototype": "tsc -b && vite build --mode prototype --outDir dist-prototype",
    "preview:prototype": "vite preview --mode prototype --outDir dist-prototype --host 127.0.0.1 --port 5173 --strictPort",
    "test:prototype": "node scripts/test-prototype.mjs"
  },
  "dependencies": {
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@xyflow/react": "^12.12.0",
    "antd": "^5.29.0",
    "d3-drag": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  }
}
